# Production Environment Variables
# Copy this file to .env.prod and update with your production values

# Database Configuration
DB_NAME=wikidb
DB_USER=postgres
DB_PASSWORD=change-this-to-very-secure-password-in-production
DB_PORT=5432

# Application Port (single port for frontend + backend)
APP_PORT=3000

# Backend Configuration
JWT_SECRET=change-this-to-very-long-random-secret-minimum-32-characters
JWT_EXPIRES_IN=7d

# CORS Configuration
# Use * for development or specific domain for production
CORS_ORIGIN=*
# For production with domain:
# CORS_ORIGIN=https://yourdomain.com

# Frontend API URL (relative path since same container)
VITE_API_URL=/api

# Optional: Logging
# LOG_LEVEL=info

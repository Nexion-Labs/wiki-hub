FROM oven/bun:1.2-alpine

WORKDIR /app

# Copy backend package files
COPY backend/package.json backend/bun.lock ./backend/

# Install dependencies
WORKDIR /app/backend
RUN bun install

# Copy backend source
WORKDIR /app
COPY backend/ ./backend/

# Expose port
EXPOSE 3000

# The command will be overridden by docker-compose
CMD ["bun", "run", "dev"]

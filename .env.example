# Database Configuration
DATABASE_URL=postgresql://wiki_user:wiki_password@localhost:5432/wiki_dev
POSTGRES_DB=wiki_dev
POSTGRES_USER=wiki_user
POSTGRES_PASSWORD=change_me_in_production

# JWT Configuration
JWT_SECRET=your_jwt_secret_min_32_characters_long_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_min_32_characters_long_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Email Configuration (Optional - for EOL alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@wiki-app.com

# Frontend Configuration
VITE_API_URL=http://localhost:3000/api
